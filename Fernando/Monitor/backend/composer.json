{
    "name": "sistema-monitor/backend",
    "description": "Backend del Sistema Monitor de Recursos",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "config/database.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public"
    },
    "minimum-stability": "stable"
}
